{
  "_comment": "AEON config — independent file, NOT parsed by OpenCode schema. Read by AEON skill at startup.",

  "auto_evolution": {
    "enabled": true,
    "mode": "incremental",
    "trigger_on": {
      "correction_threshold": 3,
      "success_threshold": 5
    },
    "auto_apply": ["prompt_clarify", "example_add", "knowledge_update", "trigger_tune"],
    "require_review": ["tool_add", "tool_remove", "strategy_inject", "constraint_add"],
    "require_approval": ["model_change", "core_behavior_change", "cross_entity_change"]
  },

  "bootstrap": {
    "enabled": true,
    "necessity_gates": {
      "gate_1_frequency_min": 3,
      "gate_5_complexity_min": 2,
      "conversation_lookback": 50
    },
    "default_action_on_fail": "memory"
  },

  "fitness": {
    "regression_test_conversations": 3,
    "adversarial_agents": 2,
    "auto_apply_threshold": 0.85,
    "review_threshold": 0.7,
    "rollback_on_regression": 0.1
  },

  "limits": {
    "max_evolutions_per_day": 5,
    "max_auto_apply_per_day": 3,
    "cooldown_hours_per_entity": 4
  },

  "storage": {
    "_base": "Relative to this config file (aeon.json). Resolves to ~/.config/opencode/aeon/.",
    "evolution_history": "evolution-history.jsonl",
    "pending_review": "pending-review.md",
    "genomes": "genomes/",
    "rejected_log": "rejected.jsonl"
  }
}
